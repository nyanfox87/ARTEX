# Docker 部署配置（複製為 .env）
# 本儲存庫釋出的 Docker Hub 映像地址；參見 README 的部署說明。
ARTEX_IMAGE=ruoji6/artex
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二選一或都填；也可留空到 UI 裡配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
